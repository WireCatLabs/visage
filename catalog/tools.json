{
  "requirements": {
    "nodeLabel": "Node.js 22.16+ or 24+",
    "nodeDownload": "https://nodejs.org/en/download"
  },
  "tools": [
    {
      "id": "tg",
      "name": "Telegram",
      "tagline": "Your Telegram account, for the terminal and AI agents",
      "bin": "tg",
      "package": "@wirecat/tg-cli",
      "summary": "A Telegram client for the terminal and for AI agents, on your own account.",
      "docs": "https://wirecat.dev/en/docs/tg",
      "repo": "https://github.com/WireCatLabs/tg-cli",
      "profiles": {
        "args": ["account", "list", "--json"],
        "shape": "items"
      },
      "doctor": ["{profile}", "doctor", "--json"],
      "runs": {
        "list": ["runs", "list", "{query}", "--limit", "{limit}", "--page", "{page}", "--json"],
        "show": ["runs", "show", "{run}", "--json"]
      },
      "setup": ["{profile}", "setup"],
      "skill": {
        "status": ["skill", "status", "--json"],
        "install": ["skill", "install", "--for", "{target}", "--json"]
      },
      "storeInfo": ["store", "info", "--json"],
      "storage": {
        "app": "tg-cli",
        "env": "TG"
      },
      "settings": {
        "show": ["{profile}", "config", "show", "--json"],
        "set": ["{profile}", "config", "set", "--json"],
        "unset": ["{profile}", "config", "unset", "--json"],
        "shape": "rows",
        "perProfile": true,
        "defaults": true,
        "jsonValues": false,
        "keys": null,
        "readOnly": ["default_profile"]
      },
      "signIn": {
        "gives": "Lets your agent read and search your Telegram chats, and send messages when you ask.",
        "asks": "The first time, your phone number and the code Telegram sends, to register your own Telegram app. Then a QR code to scan in Telegram: Settings → Devices → Link Desktop Device."
      }
    },
    {
      "id": "max",
      "name": "MAX",
      "tagline": "MAX bots and your personal account, from the terminal",
      "bin": "max",
      "package": "@wirecat/max-cli",
      "summary": "MAX Messenger from the terminal: bots through the official Bot API, and your personal account.",
      "docs": "https://wirecat.dev/en/docs/max",
      "repo": "https://github.com/WireCatLabs/max-cli",
      "profiles": {
        "args": ["account", "list", "--json"],
        "shape": "items"
      },
      "doctor": ["{profile}", "doctor", "--json"],
      "runs": {
        "list": ["runs", "list", "{query}", "--limit", "{limit}", "--page", "{page}", "--json"],
        "show": ["runs", "show", "{run}", "--json"]
      },
      "setup": ["{profile}", "setup"],
      "skill": {
        "status": ["skill", "status", "--json"],
        "install": ["skill", "install", "--for", "{target}", "--json"]
      },
      "storeInfo": ["store", "info", "--json"],
      "storage": {
        "app": "max-cli",
        "env": "MAX"
      },
      "settings": {
        "show": ["{profile}", "config", "show", "--json"],
        "set": ["{profile}", "config", "set", "--json"],
        "unset": ["{profile}", "config", "unset", "--json"],
        "shape": "rows",
        "perProfile": true,
        "defaults": true,
        "jsonValues": false,
        "keys": null,
        "readOnly": ["default_profile"]
      },
      "signIn": {
        "gives": "Lets your agent read and search your MAX chats, and send messages when you ask.",
        "asks": "A QR code to scan with the MAX app on your phone."
      }
    },
    {
      "id": "wa",
      "name": "WhatsApp",
      "tagline": "Your WhatsApp account as a linked device",
      "bin": "wa",
      "package": "@wirecat/whatsapp-cli",
      "summary": "Your WhatsApp account from the terminal, as a linked device, for agents and scripts.",
      "docs": "https://wirecat.dev/en/docs/wa",
      "repo": "https://github.com/WireCatLabs/whatsapp-cli",
      "profiles": {
        "args": ["account", "list", "--json"],
        "shape": "items"
      },
      "doctor": ["{profile}", "doctor", "--json"],
      "runs": {
        "list": ["runs", "list", "{query}", "--limit", "{limit}", "--page", "{page}", "--json"],
        "show": ["runs", "show", "{run}", "--json"]
      },
      "setup": ["{profile}", "setup"],
      "skill": {
        "status": ["skill", "status", "--json"],
        "install": ["skill", "install", "--for", "{target}", "--json"]
      },
      "storeInfo": ["store", "info", "--json"],
      "storage": {
        "app": "whatsapp-cli",
        "env": "WA"
      },
      "settings": {
        "show": ["{profile}", "config", "show", "--json"],
        "set": ["{profile}", "config", "set", "--json"],
        "unset": ["{profile}", "config", "unset", "--json"],
        "shape": "rows",
        "perProfile": true,
        "defaults": true,
        "jsonValues": false,
        "keys": null,
        "readOnly": ["default_profile"]
      },
      "signIn": {
        "gives": "Lets your agent read and search your WhatsApp chats, and send messages when you ask.",
        "asks": "A QR code to scan in WhatsApp: Settings → Linked devices → Link a device."
      }
    },
    {
      "id": "zm",
      "name": "Zoom",
      "tagline": "Zoom transcripts and recordings, searchable",
      "bin": "zm",
      "package": "@wirecat/zoom-cli",
      "summary": "Keep Zoom transcripts and recordings, search meeting evidence and give your agent context for the next call.",
      "docs": "https://wirecat.dev/en/docs/zm",
      "repo": "https://github.com/WireCatLabs/zoom-cli",
      "profiles": {
        "args": ["doctor", "--json"],
        "shape": "item.profiles"
      },
      "doctor": ["{profile}", "session", "status", "--json"],
      "runs": null,
      "setup": ["{profile}", "session", "start"],
      "skill": {
        "status": ["skill", "status", "--json"],
        "install": ["skill", "install", "--for", "{target}", "--json"]
      },
      "storeInfo": null,
      "storage": {
        "app": "zm",
        "env": "ZM"
      },
      "settings": {
        "show": ["config", "show", "--json"],
        "set": ["config", "set", "--json"],
        "unset": null,
        "shape": "flat",
        "perProfile": false,
        "defaults": false,
        "jsonValues": false,
        "keys": {
          "client_id": "zoom.client_id",
          "source": "source",
          "files_folder": "files.folder",
          "files_timezone": "files.timezone"
        },
        "readOnly": []
      },
      "signIn": {
        "gives": "Lets your agent find your Zoom meetings and read their transcripts and summaries.",
        "asks": "Your browser opens Zoom to approve access. Zoom first needs an app of your own, made once in the Zoom App Marketplace.",
        "guide": "https://github.com/WireCatLabs/zoom-cli/blob/main/docs/zoom-app.md"
      }
    },
    {
      "id": "drive",
      "name": "Google Drive",
      "tagline": "Google Drive folders as local, searchable text",
      "bin": "drive",
      "package": "@wirecat/drive-cli",
      "summary": "Import selected Google folders, search documents locally and keep tags, notes and source-backed memories.",
      "docs": "https://wirecat.dev/en/docs/drive",
      "repo": "https://github.com/WireCatLabs/drive-cli",
      "profiles": {
        "args": ["session", "list", "--json"],
        "shape": "item.items"
      },
      "doctor": ["{profile}", "status", "--json"],
      "runs": null,
      "setup": ["{profile}", "session", "start"],
      "skill": {
        "status": ["skill", "status", "--json"],
        "install": ["skill", "install", "--for", "{target}", "--json"]
      },
      "storeInfo": null,
      "storage": {
        "app": "drive-cli",
        "env": "DRIVE"
      },
      "settings": {
        "show": ["config", "show", "--json"],
        "set": ["{profile}", "config", "set", "--json"],
        "unset": null,
        "shape": "profiles",
        "perProfile": true,
        "defaults": true,
        "jsonValues": true,
        "keys": null,
        "readOnly": ["principal", "roots", "mirrors", "storage"]
      },
      "signIn": {
        "gives": "Lets your agent find and read your Google Drive files. It cannot change them.",
        "asks": "Your browser opens Google: choose the account and allow read-only access to Drive."
      }
    },
    {
      "id": "memo",
      "name": "Memo",
      "tagline": "Notes, mail and messages in one place for your agent",
      "bin": "memo",
      "package": "@wirecat/cli-memo",
      "summary": "Your notes, mail and messages in one place for your AI agent: search, tags, people and memories, on your computer.",
      "docs": "https://wirecat.dev/en/docs/memo",
      "repo": "https://github.com/WireCatLabs/cli-memo",
      "profiles": null,
      "doctor": ["doctor", "--json"],
      "runs": null,
      "setup": null,
      "skill": {
        "status": ["skill", "status", "--json"],
        "install": ["skill", "install", "--for", "{target}", "--json"],
        "doctorSkills": ["doctor", "--json"]
      },
      "storeInfo": null,
      "storage": {
        "app": "cli-memo",
        "env": "MEMO"
      },
      "settings": null,
      "signIn": null
    }
  ],
  "sharedStorage": {
    "app": "WireCat",
    "env": "WIRECAT",
    "label": "Shared WireCat archive"
  }
}
